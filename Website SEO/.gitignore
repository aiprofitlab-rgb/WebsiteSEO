node_modules/
.DS_Store

# large source media — never deploy or commit
media/
*.mp4
*.mov
.tmp/

# Customer invoices. THIS REPO IS PUBLIC — a committed invoice publishes a real
# customer's name, CR number, e-mail, phone and what they paid. Only the template,
# the script and the two placeholder specs are tracked.
invoices/customers/*.json
!invoices/customers/_blank.json
!invoices/customers/_example-paid.json
invoices/out/
invoices/register.json
invoices/.env

# Visitor journey reports. THIS REPO IS PUBLIC — these contain GA4 visitor
# identifiers, full page-by-page journeys and, where the Aiden CSV was joined,
# verbatim things visitors typed into the chat. The cache holds the same rows
# straight from BigQuery. Only tools/build_journey_report.py is tracked.
out/journey-*.html
out/.journey-cache/
Aiden_Chat*.csv

# Generated carousel slides. THIS REPO IS PUBLIC and these are large binaries
# that belong in the IG content folder, not in git. The tool and the decks that
# produce them are tracked.
out/carousel/
tools/carousel/fonts/

# Prospect lists and outreach working files. THIS REPO IS PUBLIC — these hold
# ~20,000 Omani businesses' phone numbers, harvested emails and per-lead notes.
# Committing them republishes a personal-data set under our name, and the CRM
# columns (consent, outcome, notes) are commercially sensitive besides.
# Only the tools in tools/prospecting/ are tracked.
out/outreach/
out/prospecting/
