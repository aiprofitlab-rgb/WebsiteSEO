# ==============================================================
# | TTFB-Optimized .htaccess for aiprofitlab.io                |
# | Goal: Reduce server processing time per request             |
# ==============================================================

# --- Compression (mod_deflate) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon application/manifest+json
    AddOutputFilterByType DEFLATE font/opentype font/otf font/ttf
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf application/x-font-opentype
</IfModule>

# --- MIME types not in the stock shared-hosting set ---
<IfModule mod_mime.c>
    # Without this the manifest goes out as text/plain and Chrome ignores it,
    # which costs the Android home-screen icon it exists to provide.
    AddType application/manifest+json .webmanifest
</IfModule>

# --- Expires Headers (mod_expires) ---
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML: short cache so content updates propagate quickly
    ExpiresByType text/html "access plus 10 minutes"
    # Static assets: aggressive 1-year cache
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# --- Cache-Control Headers (mod_headers) ---
<IfModule mod_headers.c>
    # Immutable static assets (1 year). Excludes aiden-chat.js by name: the
    # rule below is what that file is supposed to get, and `Header set` from
    # the FIRST matching FilesMatch is not overridden by a later one - so with
    # .js matching here the intended 600s was silently discarded and
    # production served the widget `max-age=31536000, immutable` regardless of
    # what the block below said.
    <FilesMatch "^(?!aiden-chat\.js$|favicon\.ico$).*\.(jpeg|jpg|png|webp|svg|ico|css|js|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # favicon.ico is the one icon that cannot carry a ?v= token: browsers and
    # SERP crawlers fetch /favicon.ico by convention, ignoring the <link>. Give
    # it a day instead of a year so a future mark change is not stuck behind
    # `immutable` in every browser that has ever loaded the site. Same
    # mod_expires problem as aiden-chat.js below - ExpiresByType image/x-icon
    # is not set, but ico is served as image/vnd.microsoft.icon on some hosts,
    # so turn expiry off here rather than rely on that.
    <FilesMatch "^favicon\.ico$">
        <IfModule mod_expires.c>
            ExpiresActive Off
        </IfModule>
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
    # The Aiden widget is the one script that ships from a stable filename and
    # changes often. Pinned for a year it kept serving an old build from the CDN
    # edge long after the origin was correct, so it revalidates like a page.
    # Pages also carry a ?v=<hash> token (tools/aiden_version.py) - belt and
    # braces, because this header cannot evict what an edge already holds.
    <FilesMatch "^aiden-chat\.js$">
        # mod_expires is the other half of the problem: ExpiresByType above
        # pins every application/javascript response to a year, and it runs
        # after mod_headers - so excluding this file from the immutable
        # FilesMatch alone would not have been enough. Turned off for this
        # file only, which leaves the header below as the one in effect.
        <IfModule mod_expires.c>
            ExpiresActive Off
        </IfModule>
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>
    # HTML pages: short cache with revalidation
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>
    # The smart-website-offer.*.html no-cache rule was removed 2026-08-27 with
    # the files it named. Its successor, smart-storefront{,-ar}.html, does NOT
    # need one: the seat price and seats-left are fetched live by JS from the
    # ledger on every load, so the cached HTML never carries a stale figure.
    # It keeps the standard 600s must-revalidate above, which an indexed page
    # wants anyway.
    # Remove ETag to avoid conditional-GET overhead on shared hosting
    Header unset ETag
</IfModule>
FileETag None

# --- Block Non-Public Files ---
# These are already on the server from earlier deploys. The workflow's
# `exclude` stops NEW ones being uploaded, but excluded files are also
# skipped by the delete pass, so the existing copies must be blocked here.
# Verified publicly readable (HTTP 200) on 2026-08-04 before this block.
<FilesMatch "(^\.|\.(py|pyc|log|bak|orig|sh|zip|sql|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicit: the FTP deploy state file is a full inventory of every file on
# the server (names, sizes, SHA-256 hashes). Never serve it.
<Files ".ftp-deploy-sync-state.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# --- Basic Server Configuration ---
Options +FollowSymLinks -MultiViews -Indexes
DirectoryIndex index.html

# Allow access
# (Removed <Files "*"> directive to prevent 403 errors with bots/crawlers)

# --- URL Rewriting ---
RewriteEngine On
RewriteBase /

# 1. Force trailing slash on ALL URLs (except real files)
# The !\.html$ guard is load-bearing: without it a MISSING .html file gets a
# slash appended (/x.html -> /x.html/), rule 4 then maps that to x.html.html,
# and the request redirects forever instead of 404ing. A failed deploy on
# 2026-08-04 left that infinite chain cached in Hostinger's CDN. Requests
# ending in .html are handled by rule 7 instead.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://aiprofitlab.io/$1/ [L,R=301]

# 2. Specific Hub Redirects (PRIORITY)
# The Early Bird offer page was retired 2026-08-26. It published OMR 249
# against a struck-through OMR 850, while /en/services/ publishes OMR 950 /
# OMR 1,450 for the same build - two indexed pages disagreeing on the price of
# one product, one of them in Product schema. The live campaign is the Smart
# Storefront, which carries the same OMR 249 seat price from the ledger, so
# these 301s land an old link on the offer it was promising. The three files
# were deleted on 2026-08-27; these rules are file-independent, so the URLs go
# on resolving to the campaign page rather than 404ing.
RewriteRule ^en/smart-website-offer/?$ /en/smart-storefront/ [R=301,L]
RewriteRule ^smart-website-offer/?$    /smart-storefront-ar/ [R=301,L]
# The stale sitemap advertised these two pages by their RAW .html paths for
# months, so those are the URLs Google actually holds. They resolve as files,
# which means the pretty-URL redirects above never see them - they need their
# own. Nothing rewrites to these filenames any more, so there is no loop.
# THE_REQUEST guard, same reason as section 6: it matches what the browser
# actually asked for, so an internal rewrite that ever lands on one of these
# filenames cannot be turned into an external redirect by these rules.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /en/smart-website-offer\.html\ HTTP/
RewriteRule ^en/smart-website-offer\.html$  /en/smart-storefront/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /smart-website-offer\.html\ HTTP/
RewriteRule ^smart-website-offer\.html$     /smart-storefront-ar/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /smart-website-offer-en\.html\ HTTP/
RewriteRule ^smart-website-offer-en\.html$  /en/smart-storefront/ [R=301,L]
RewriteRule ^en/blog/$ blog/index.html [L]
RewriteRule ^en/academy/$ academy/index.html [L]

# 2b. v4 launch, 2026-08-21 - the English pages moved onto clean URLs.
# These must sit above rules 3/3b: the old English pages USED to sit on disk as
# <name>-en.html, and without a redirect here rule 3b would have gone on serving
# them. The files were deleted 2026-08-27 once these 301s were verified live;
# the rules stay, because the old paths are indexed and the equity has to move.
RewriteRule ^en/services-en/?$   /en/services/   [R=301,L]
RewriteRule ^en/process-en/?$    /en/process/    [R=301,L]
RewriteRule ^en/about-en/?$      /en/about/      [R=301,L]
RewriteRule ^en/contact-en/?$    /en/contact/    [R=301,L]

# The English homepage moved from /en/ to the site root, and the Arabic
# homepage took /ar/. Everything else Arabic keeps the root paths it had.
RewriteRule ^en/?$               /               [R=301,L]
RewriteRule ^en/index/?$         /               [R=301,L]

# The same four pages were also reachable WITHOUT the /en/ prefix - that is the
# older root-level convention, and rule 5 still finds <name>-en.html on disk and
# serves the retired v3 skin at 200. Thirteen in-article links pointed here.
RewriteRule ^services-en/?$      /en/services/   [R=301,L]
RewriteRule ^process-en/?$       /en/process/    [R=301,L]
RewriteRule ^about-en/?$         /en/about/      [R=301,L]
RewriteRule ^contact-en/?$       /en/contact/    [R=301,L]
RewriteRule ^missed-call-simulator-en/?$ /en/simulators/ [R=301,L]

# The English offer page lives at /en/smart-website-offer/ (section 2 maps it
# to smart-website-offer-en.html on disk). That filename is ALSO reachable
# through rule 5 as /smart-website-offer-en/, which served the same document
# at 200 under a second URL. It self-canonicals to the /en/ form, so nothing
# was ranking on it - but a duplicate that resolves is a duplicate.
RewriteRule ^smart-website-offer-en/?$ /en/smart-storefront/ [R=301,L]

# One demo page and one simulator page now carry what four separate pages
# used to. The originals were deleted 2026-08-27; these 301s are what keeps
# their indexed URLs resolving.
RewriteRule ^en/whatsapp-receptionist-demo/?$    /en/demos/      [R=301,L]
RewriteRule ^whatsapp-receptionist-demo/?$       /en/demos/      [R=301,L]
RewriteRule ^customized-ceo-dashboard-demo/?$    /en/demos/      [R=301,L]
RewriteRule ^en/missed-call-simulator-en/?$      /en/simulators/ [R=301,L]
RewriteRule ^en/campaign-roi-simulator/?$        /en/simulators/ [R=301,L]
RewriteRule ^campaign-roi-simulator/?$           /en/simulators/ [R=301,L]

# The preview paths the set was built and reviewed on. Never indexed, but they
# were shared as links, so they resolve rather than 404.
RewriteRule ^en/index-v4/?$      /               [R=301,L]
RewriteRule ^en/services-v4/?$   /en/services/   [R=301,L]
RewriteRule ^en/process-v4/?$    /en/process/    [R=301,L]
RewriteRule ^en/about-v4/?$      /en/about/      [R=301,L]
RewriteRule ^en/contact-v4/?$    /en/contact/    [R=301,L]
RewriteRule ^en/simulator-v4/?$  /en/simulators/ [R=301,L]
RewriteRule ^en/demo-v4/?$       /en/demos/      [R=301,L]
RewriteRule ^en/checkout-v4/?$   /en/checkout/   [R=301,L]
RewriteRule ^en/order-v4/?$      /en/order/      [R=301,L]
RewriteRule ^en/blog-v4/?$       /blog/          [R=301,L]
RewriteRule ^en/article-v4/?$    /blog/en/2026-06-25-true-cost-missed-whatsapp-inquiries-oman/ [R=301,L]

# 2b-i. Retired internal drafts, deleted 2026-08-27. None was ever linked from
# the live site or listed in a sitemap, and all carried noindex - but they were
# served at 200 and a few were shared as preview links. One rule lands any such
# link on the live homepage instead of a 404. `index-v3` is the old v3 homepage
# and the `-new` set is the never-shipped skin; `en/index.html` is handled by
# rule 7 and `^en/?$` above.
RewriteRule ^en/(index-new|about-new|services-new|process-new|contact-new|blog-new|article-new|academy-new|preview-templates|index-cinematic|index-v3)/?$ / [R=301,L]

# 2b-ii. The Smart Storefront claim page became a page that can also take the
# money: /en/pay/. Claim references already went out by email pointing at
# /en/claim/?ref=..., and en/claim.html is still on disk, so rule 3 would go on
# serving the upload-only page to them forever. mod_rewrite carries the query
# string through a substitution that has none of its own, so the reference
# survives the hop.
RewriteRule ^en/claim/?$          /en/pay/        [R=301,L]

# 2c. Arabic v4, 2026-08-21 - the Arabic set moved onto this skin and gained
# four pages it never had. The five CORE Arabic pages (/ar/, /services/,
# /process/, /about/, /contact/) keep their URLs and need no rule here: only
# the skin under them changed, so nothing 301s and no ranking moves.
#
# The four new pages take the site's existing `-ar` suffix convention, which
# rule 5 already maps to a root file - no rewrite is needed to SERVE them.
# What is needed is retiring the stand-alone Arabic demo and simulator pages
# that /demos-ar/ and /simulators-ar/ now carry. The old files were deleted
# 2026-08-27 alongside the English ones; these 301s are file-independent.
RewriteRule ^missed-call-simulator-ar/?$          /simulators-ar/ [R=301,L]
RewriteRule ^campaign-roi-simulator-ar/?$         /simulators-ar/ [R=301,L]
RewriteRule ^whatsapp-receptionist-demo-ar/?$     /demos-ar/      [R=301,L]
RewriteRule ^customized-ceo-dashboard-demo-ar/?$  /demos-ar/      [R=301,L]

# 3. Serve pages that genuinely live INSIDE public_html/en/
# Must come before rule 3b. That rule encodes the site's older convention,
# where English pages sat at the document root as <name>-en.html, so it sends
# /en/foo/ to /foo.html at the ROOT. Any page that actually lives in
# public_html/en/ is therefore unreachable: the .html form 301s to the clean
# form (rule 7), and the clean form looks for a root file that isn't there and
# 404s. That is what broke /en/index-cinematic/ and every /en/*-new/ template.
# The -f test means this fires only when the file really exists, so nothing
# that resolves today can change behaviour. The `/en/*-new/` templates it was
# written for are gone (rule 2b-i now 301s them); the rule still matters for
# every real page that lives in public_html/en/, e.g. /en/smart-storefront/.
RewriteCond %{REQUEST_URI} ^/en/([^/]+)/$
RewriteCond %{DOCUMENT_ROOT}/en/%1.html -f
RewriteRule ^en/([^/]+)/$ en/$1.html [L]

# 3b. Map /en/ subpaths to root -en.html files (older convention)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/([^/]+)/$ $1.html [L]

# 4. Map Clean URLs for Blog and Academy subdirectories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(blog|academy)/(en|ar)/([^/]+)/$ $1/$2/$3.html [L]

# 5. Map clean directory URLs to root .html files (Arabic/General)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/$ $1.html [L]

# 6. Legacy Redirects (Cleanup)
# These are the original mixed-case / underscore URLs. Until 2026-08-27 each
# pointed at the hyphenated page that replaced it, which by then ALSO 301'd -
# so every one of them was a two-hop chain, and the second hop's target file
# has now been deleted. Repointed at the final destination: one hop each.
RewriteRule ^Missed-Call-Simulator-en/?$ /en/simulators/ [R=301,L]
RewriteRule ^Missed-Call-Simulator-ar/?$ /simulators-ar/ [R=301,L]
RewriteRule ^Campaign_ROI_Simulator-ar/?$ /simulators-ar/ [R=301,L]
RewriteRule ^Campaign_ROI_Simulator/?$ /en/simulators/ [R=301,L]
RewriteRule ^whatsapp_receptionist_demo_ar/?$ /demos-ar/ [R=301,L]
RewriteRule ^whatsapp_receptionist_demo/?$ /en/demos/ [R=301,L]
RewriteRule ^Customized_CEO_Dashboard_demo-ar/?$ /demos-ar/ [R=301,L]
RewriteRule ^Customized_CEO_Dashboard_demo/?$ /en/demos/ [R=301,L]
# The dashboard demo was ALSO reachable without the _demo suffix, because
# Customized_CEO_Dashboard.html sat at the root and rule 5 served it. That file
# is deleted, so this path needs a rule of its own or it 404s. Anchored, so it
# cannot swallow the _demo forms above.
RewriteRule ^Customized_CEO_Dashboard/?$ /en/demos/ [R=301,L]
RewriteRule ^academy_ar/?$ /academy-ar/ [R=301,L]
RewriteRule ^blog_ar/?$ /blog-ar/ [R=301,L]

# 6b. One story, published twice a day apart under the identical title, in
# both languages. The pair cannibalised each other and gave an engine asked
# about the same work two documents to choose between. The 13 June pieces are
# canonical; these two URLs fold into them.
RewriteRule ^blog/en/2026-06-14-how-we-automated-lead-recovery-muscat-hypermarket-case-study/?$ /blog/en/2026-06-13-automated-lead-recovery-muscat-hypermarket-case-study/ [R=301,L]
RewriteRule ^blog/ar/2026-06-14-how-we-automated-lead-recovery-muscat-hypermarket-case-study/?$ /blog/ar/2026-06-13-automated-lead-recovery-muscat-hypermarket-case-study/ [R=301,L]

# 7. Special case for index.html files. MUST sit above rule 8: rule 8's
# ^(.+)\.html$ also matches these, and being first it would send
# /en/index.html to /en/index/ and /index.html to /index/ - one extra hop
# each, and in the /en/ case a hop that lands ON the retired v3 homepage
# instead of escaping it. Both go straight to the live English root here.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /en/index\.html\ HTTP/
RewriteRule ^en/index\.html$ https://aiprofitlab.io/ [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://aiprofitlab.io/ [R=301,L]

# 8. Redirect .html URLs to clean slash versions
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^(.+)\.html$ https://aiprofitlab.io/$1/ [R=301,L]
