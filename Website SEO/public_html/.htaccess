# ==============================================================
# | TTFB-Optimized .htaccess for aiprofitlab.io                |
# | Goal: Reduce server processing time per request             |
# ==============================================================

# --- Compression (mod_deflate) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/opentype font/otf font/ttf
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf application/x-font-opentype
</IfModule>

# --- Expires Headers (mod_expires) ---
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML: short cache so content updates propagate quickly
    ExpiresByType text/html "access plus 10 minutes"
    # Static assets: aggressive 1-year cache
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# --- Cache-Control Headers (mod_headers) ---
<IfModule mod_headers.c>
    # Immutable static assets (1 year)
    <FilesMatch "\.(jpeg|jpg|png|webp|svg|ico|css|js|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # The Aiden widget is the one script that ships from a stable filename and
    # changes often. Pinned for a year it kept serving an old build from the CDN
    # edge long after the origin was correct, so it revalidates like a page.
    # Pages also carry a ?v=<hash> token (tools/aiden_version.py) - belt and
    # braces, because this header cannot evict what an edge already holds.
    <FilesMatch "^aiden-chat\.js$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>
    # HTML pages: short cache with revalidation
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=600, must-revalidate"
    </FilesMatch>
    # Smart Website offer pages: bypass cache to reflect instant updates
    <FilesMatch "smart-website-offer.*\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    </FilesMatch>
    # Remove ETag to avoid conditional-GET overhead on shared hosting
    Header unset ETag
</IfModule>
FileETag None

# --- Block Non-Public Files ---
# These are already on the server from earlier deploys. The workflow's
# `exclude` stops NEW ones being uploaded, but excluded files are also
# skipped by the delete pass, so the existing copies must be blocked here.
# Verified publicly readable (HTTP 200) on 2026-08-04 before this block.
<FilesMatch "(^\.|\.(py|pyc|log|bak|orig|sh|zip|sql|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicit: the FTP deploy state file is a full inventory of every file on
# the server (names, sizes, SHA-256 hashes). Never serve it.
<Files ".ftp-deploy-sync-state.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# --- Basic Server Configuration ---
Options +FollowSymLinks -MultiViews -Indexes
DirectoryIndex index.html

# Allow access
# (Removed <Files "*"> directive to prevent 403 errors with bots/crawlers)

# --- URL Rewriting ---
RewriteEngine On
RewriteBase /

# 1. Force trailing slash on ALL URLs (except real files)
# The !\.html$ guard is load-bearing: without it a MISSING .html file gets a
# slash appended (/x.html -> /x.html/), rule 4 then maps that to x.html.html,
# and the request redirects forever instead of 404ing. A failed deploy on
# 2026-08-04 left that infinite chain cached in Hostinger's CDN. Requests
# ending in .html are handled by rule 7 instead.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.html$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://aiprofitlab.io/$1/ [L,R=301]

# 2. Specific Hub Redirects (PRIORITY)
RewriteRule ^en/smart-website-offer/?$ smart-website-offer-en.html [L]
RewriteRule ^en/blog/$ blog/index.html [L]
RewriteRule ^en/academy/$ academy/index.html [L]

# 2b. v4 launch, 2026-08-21 - the English pages moved onto clean URLs.
# These must sit above rules 3/3b: the old English pages are still on disk as
# <name>-en.html, so without a redirect here rule 3b would go on serving them.
# 301, not 302 - the old paths are indexed and the equity has to move.
RewriteRule ^en/services-en/?$   /en/services/   [R=301,L]
RewriteRule ^en/process-en/?$    /en/process/    [R=301,L]
RewriteRule ^en/about-en/?$      /en/about/      [R=301,L]
RewriteRule ^en/contact-en/?$    /en/contact/    [R=301,L]

# The English homepage moved from /en/ to the site root, and the Arabic
# homepage took /ar/. Everything else Arabic keeps the root paths it had.
RewriteRule ^en/?$               /               [R=301,L]

# One demo page and one simulator page now carry what four separate pages
# used to. The originals stay on disk; only the URLs are retired.
RewriteRule ^en/whatsapp-receptionist-demo/?$    /en/demos/      [R=301,L]
RewriteRule ^whatsapp-receptionist-demo/?$       /en/demos/      [R=301,L]
RewriteRule ^customized-ceo-dashboard-demo/?$    /en/demos/      [R=301,L]
RewriteRule ^en/missed-call-simulator-en/?$      /en/simulators/ [R=301,L]
RewriteRule ^en/campaign-roi-simulator/?$        /en/simulators/ [R=301,L]
RewriteRule ^campaign-roi-simulator/?$           /en/simulators/ [R=301,L]

# The preview paths the set was built and reviewed on. Never indexed, but they
# were shared as links, so they resolve rather than 404.
RewriteRule ^en/index-v4/?$      /               [R=301,L]
RewriteRule ^en/services-v4/?$   /en/services/   [R=301,L]
RewriteRule ^en/process-v4/?$    /en/process/    [R=301,L]
RewriteRule ^en/about-v4/?$      /en/about/      [R=301,L]
RewriteRule ^en/contact-v4/?$    /en/contact/    [R=301,L]
RewriteRule ^en/simulator-v4/?$  /en/simulators/ [R=301,L]
RewriteRule ^en/demo-v4/?$       /en/demos/      [R=301,L]
RewriteRule ^en/checkout-v4/?$   /en/checkout/   [R=301,L]
RewriteRule ^en/order-v4/?$      /en/order/      [R=301,L]
RewriteRule ^en/blog-v4/?$       /blog/          [R=301,L]
RewriteRule ^en/article-v4/?$    /blog/en/2026-06-25-true-cost-missed-whatsapp-inquiries-oman/ [R=301,L]

# 2c. Arabic v4, 2026-08-21 - the Arabic set moved onto this skin and gained
# four pages it never had. The five CORE Arabic pages (/ar/, /services/,
# /process/, /about/, /contact/) keep their URLs and need no rule here: only
# the skin under them changed, so nothing 301s and no ranking moves.
#
# The four new pages take the site's existing `-ar` suffix convention, which
# rule 5 already maps to a root file - no rewrite is needed to SERVE them.
# What is needed is retiring the stand-alone Arabic demo and simulator pages
# that /demos-ar/ and /simulators-ar/ now carry. The old files stay on disk
# behind these redirects as a fallback, exactly as the English ones did.
RewriteRule ^missed-call-simulator-ar/?$          /simulators-ar/ [R=301,L]
RewriteRule ^campaign-roi-simulator-ar/?$         /simulators-ar/ [R=301,L]
RewriteRule ^whatsapp-receptionist-demo-ar/?$     /demos-ar/      [R=301,L]
RewriteRule ^customized-ceo-dashboard-demo-ar/?$  /demos-ar/      [R=301,L]

# 3. Serve pages that genuinely live INSIDE public_html/en/
# Must come before rule 3b. That rule encodes the site's older convention,
# where English pages sat at the document root as <name>-en.html, so it sends
# /en/foo/ to /foo.html at the ROOT. Any page that actually lives in
# public_html/en/ is therefore unreachable: the .html form 301s to the clean
# form (rule 7), and the clean form looks for a root file that isn't there and
# 404s. That is what broke /en/index-cinematic/ and every /en/*-new/ template.
# The -f test means this fires only when the file really exists, so nothing
# that resolves today can change behaviour.
RewriteCond %{REQUEST_URI} ^/en/([^/]+)/$
RewriteCond %{DOCUMENT_ROOT}/en/%1.html -f
RewriteRule ^en/([^/]+)/$ en/$1.html [L]

# 3b. Map /en/ subpaths to root -en.html files (older convention)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^en/([^/]+)/$ $1.html [L]

# 4. Map Clean URLs for Blog and Academy subdirectories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(blog|academy)/(en|ar)/([^/]+)/$ $1/$2/$3.html [L]

# 5. Map clean directory URLs to root .html files (Arabic/General)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/$ $1.html [L]

# 6. Legacy Redirects (Cleanup)
RewriteRule ^Missed-Call-Simulator-en/?$ /en/missed-call-simulator-en/ [R=301,L]
RewriteRule ^Campaign_ROI_Simulator-ar/?$ /campaign-roi-simulator-ar/ [R=301,L]
RewriteRule ^academy_ar/?$ /academy-ar/ [R=301,L]
RewriteRule ^Campaign_ROI_Simulator/?$ /campaign-roi-simulator/ [R=301,L]
RewriteRule ^whatsapp_receptionist_demo/?$ /whatsapp-receptionist-demo/ [R=301,L]
RewriteRule ^Missed-Call-Simulator-ar/?$ /missed-call-simulator-ar/ [R=301,L]
RewriteRule ^Customized_CEO_Dashboard_demo/?$ /customized-ceo-dashboard-demo/ [R=301,L]
RewriteRule ^blog_ar/?$ /blog-ar/ [R=301,L]
RewriteRule ^Customized_CEO_Dashboard_demo-ar/?$ /customized-ceo-dashboard-demo-ar/ [R=301,L]
RewriteRule ^whatsapp_receptionist_demo_ar/?$ /whatsapp-receptionist-demo-ar/ [R=301,L]

# 7. Redirect .html URLs to clean slash versions
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^(.+)\.html$ https://aiprofitlab.io/$1/ [R=301,L]

# 8. Special case for index.html files
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /en/index\.html\ HTTP/
RewriteRule ^en/index\.html$ https://aiprofitlab.io/en/ [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://aiprofitlab.io/ [R=301,L]
