# ig-automation — copy to .env and fill in. NEVER commit the filled version:
# this repo is public (github.com/aiprofitlab-rgb/WebsiteSEO).

# ---- Meta / Instagram -------------------------------------------------------

# A nonce YOU invent, pasted identically into the Meta App Dashboard webhook
# form. It is not a credential and grants nothing — it only proves the GET
# handshake came from the dashboard you configured. Generate one with:
#   openssl rand -hex 32
IG_VERIFY_TOKEN=

# App Dashboard -> Settings -> Basic -> App Secret. This one IS a credential.
# It signs every incoming payload and, as appsecret_proof, every outgoing call.
# Without it the service rejects all webhook POSTs — that is intentional.
META_APP_SECRET=

# Your Instagram professional account's user id. Optional: the service asks Meta
# on boot if it is blank. Setting it removes a startup call and, more usefully,
# guarantees the "ignore our own comments" guard works even if that call fails.
IG_USER_ID=

# Where the rotating access token is persisted. This file is REWRITTEN by the
# refresh cron, so it must be writable by the service user and must live outside
# the repo. On the VPS: /var/lib/ig-automation/token.json
IG_TOKEN_FILE=./token.json

# First-boot seed only. Once token.json exists this is ignored, and it is never
# used to overwrite a refreshed token. Prefer writing token.json directly.
IG_ACCESS_TOKEN=

# Bump when you move Graph versions. v20.0 is the version already proven against
# this account by the n8n workflows in IG DM Automation/.
IG_API_VERSION=v20.0

# ---- Storage ----------------------------------------------------------------

# Dedupe table + email-capture conversation state. Must survive restarts.
# On the VPS: /var/lib/ig-automation/state.sqlite
IG_DB_FILE=./ig-automation.sqlite

# Keyword rules. Edit and restart; no deploy needed.
# The loop breaker. Not a limit on followers — a bound on us: how many comments
# the service may take on under ONE post, and across the account, per hour. A
# reply loop that gets past every other guard stops here and sends mail. 0 mutes
# the service entirely while leaving it running.
IG_MAX_REPLIES_PER_MEDIA_PER_HOUR=12
IG_MAX_REPLIES_PER_HOUR=40

IG_RULES_FILE=./rules.json

# ---- CRM (optional) ---------------------------------------------------------

# Leave IG_SHEET_ID blank and every lead still lands in the logs as one line of
# JSON. The automation does not depend on the sheet.
IG_SHEET_ID=
IG_SHEET_TAB=IG_Leads

# Service-account JSON key. On the VPS there is no attached Google identity the
# way there is on Cloud Run, so point this at a key file:
#   /etc/ig-automation/sa.json  (chmod 600, owned by the service user)
# Share the sheet with that service account's email as an Editor.
GOOGLE_APPLICATION_CREDENTIALS=
# Only needed if the key must live somewhere the variable above cannot point to.
IG_SA_KEY_FILE=

# ---- Alerting (optional but strongly recommended) ---------------------------

# Without this, a token that stops refreshing is invisible for 60 days.
RESEND_API_KEY=
OWNER_EMAIL=hello@aiprofitlab.io

# ---- Server -----------------------------------------------------------------

PORT=8090
