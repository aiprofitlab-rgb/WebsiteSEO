# Thawani. The SECRET key authenticates the API call server-side and must never
# reach a browser; the PUBLISHABLE key appears in the redirect URL and is meant
# to be seen. Two different keys — do not swap them.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_BASE=https://uatcheckout.thawani.om   # https://checkout.thawani.om when live

# Where the buyer comes back to.
SITE_ORIGIN=https://aiprofitlab.io
ORDER_PATH=/en/order-v4/

# CORS allowlist. Never "*" — this endpoint mints payment sessions.
ALLOWED_ORIGINS=https://aiprofitlab.io,https://www.aiprofitlab.io

# Optional. Without a sheet, every order still lands in the logs as one line of
# JSON, greppable by reference.
CHECKOUT_SHEET_ID=
CHECKOUT_SHEET_TAB=Checkout_Orders

# Optional. Without a key, notifications are logged and skipped.
RESEND_API_KEY=
OWNER_EMAIL=hello@aiprofitlab.io
