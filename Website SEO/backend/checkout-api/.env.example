# Thawani. The SECRET key authenticates the API call server-side and must never
# reach a browser; the PUBLISHABLE key appears in the redirect URL and is meant
# to be seen. Two different keys — do not swap them.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_BASE=https://uatcheckout.thawani.om   # https://checkout.thawani.om when live

# The kill switch. Set to 0 to refuse every card even with live keys present —
# for switching payments off in a hurry without deleting credentials. The
# checkout page turns the refusal into its offline handover and tells the buyer
# nothing was charged, which is true.
PAY_ENABLED=1

# Where the buyer comes back to.
SITE_ORIGIN=https://aiprofitlab.io
ORDER_PATH=/en/order-v4/

# CORS allowlist. Never "*" — this endpoint mints payment sessions.
ALLOWED_ORIGINS=https://aiprofitlab.io,https://www.aiprofitlab.io

# Optional. Without a sheet, every order still lands in the logs as one line of
# JSON, greppable by reference.
CHECKOUT_SHEET_ID=
CHECKOUT_SHEET_TAB=Checkout_Orders

# Empty on Cloud Run (the attached runtime service account); a key file path
# anywhere else, including the VPS. Must be
# offer-api@aiprofitlab-offer.iam.gserviceaccount.com — the identity shared as a
# writer on the ledger sheet.
GOOGLE_APPLICATION_CREDENTIALS=

# Without a key, notifications are logged and skipped — which on a live
# checkout means NOBODY IS TOLD money landed and the BUYER GETS NO RECEIPT.
# Optional only in the sense that the service still runs.
RESEND_API_KEY=
OWNER_EMAIL=hello@aiprofitlab.io

# POST /billing/run refuses to exist without this — an unprotected billing
# trigger is one curl away from charging every customer. Generate with
# `openssl rand -hex 32`. Leave empty to keep monthly billing manual.
CRON_KEY=
