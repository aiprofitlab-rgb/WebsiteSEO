# checkout-api — copy to /etc/checkout-api/.env and fill in.
#
# systemd's EnvironmentFile is NOT a shell. Every value must be on one line,
# with no surrounding quotes and no `export`.
#
#   sudo install -d -m 700 /etc/checkout-api
#   sudo install -m 600 /dev/null /etc/checkout-api/.env
#   sudo nano /etc/checkout-api/.env
#
# chmod 600, owned by root. THIS FILE HOLDS THE LIVE THAWANI SECRET KEY — the
# one credential that can charge a real card.

# ---- Thawani -----------------------------------------------------------------
# The SECRET key authenticates the API call server-side and must never reach a
# browser; the PUBLISHABLE key appears in the redirect URL and is meant to be
# seen. Two different keys — swapping them fails every call.
#
# Values come from backend/checkout-api/.env.live in the website repo, which is
# gitignored and lives only on Nahid's Mac.
#
# THAWANI_BASE IS THE LIVE/TEST SWITCH. checkout.thawani.om is real money;
# uatcheckout.thawani.om is not. lib/thawani.js derives `live` from this string
# and /health reports it, so check /health after any change here.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_BASE=https://checkout.thawani.om

# ---- The website -------------------------------------------------------------
# Where the buyer comes back to after paying. Note this is the SITE, never this
# API's own hostname — the buyer returns to a page, not to a JSON endpoint.
SITE_ORIGIN=https://aiprofitlab.io
ORDER_PATH=/en/order-v4/

# CORS allowlist. Never "*" — this endpoint mints payment sessions.
#
# These are BROWSER ORIGINS, not this API's hostname: the pages calling it are
# served from aiprofitlab.io. The Arabic checkout (/checkout-ar/) is the same
# origin as the English one, so it needs no entry of its own.
ALLOWED_ORIGINS=https://aiprofitlab.io,https://www.aiprofitlab.io

# ---- The ledger --------------------------------------------------------------
# OPTIONAL, and the service is built to work without it: with no sheet, every
# order still lands in the journal as one line of JSON, greppable by reference.
# The guarantee that matters — an order is recorded BEFORE a payment session
# exists — holds either way.
#
# But set it. Without a sheet Nahid cannot see orders where he actually works,
# and the instance-local idempotency map is all that stops a double-click
# minting two sessions.
#
# The service account must be shared as a WRITER on the sheet. Reuse
# offer-api@aiprofitlab-offer.iam.gserviceaccount.com — it is already the
# writer on the storefront ledger, and a different account authenticates
# perfectly and then fails every write with a 403, which reads as "the sheet is
# broken" rather than "the key is wrong".
CHECKOUT_SHEET_ID=
CHECKOUT_SHEET_TAB=Checkout_Orders

# The service-account key as a FILE. On Cloud Run this was empty and
# GoogleAuth resolved the attached identity; a VPS has no attached identity, so
# Application Default Credentials falls through to this path. No code changed
# for the move.
GOOGLE_APPLICATION_CREDENTIALS=/etc/checkout-api/sa.json

# ---- Email -------------------------------------------------------------------
# Without a key every message is logged and skipped, so an order is never lost
# because email is down — but nobody is told a payment landed, and the buyer
# gets no receipt. On a live checkout that is the difference between a customer
# who feels charged and a customer who feels robbed. SET IT.
#
# A working key is on this same box at /etc/aiden-backend/.env — same Resend
# account, with aiprofitlab.io verified as a sending domain. The key that was
# on Cloud Run for the storefront is INVALID (Resend rejects it, HTTP 400); do
# not copy that one forward.
RESEND_API_KEY=
OWNER_EMAIL=hello@aiprofitlab.io

# ---- Subscriptions -----------------------------------------------------------
# POST /billing/run refuses to exist without this: an unprotected billing
# trigger is one curl away from charging every customer. There is no default
# and no "open in development" branch.
#
# Generate with:  openssl rand -hex 32
#
# Leave EMPTY to keep monthly billing manual — /billing then answers 503 and
# the Growth Desk / Assigned Admin / Visibility Desk rows are invoiced by hand
# from the ledger. That is a legitimate choice for launch; it is not a fault.
CRON_KEY=

# ---- Server ------------------------------------------------------------------
# 8090 is ig-automation, 8091 aiden-backend, 8092 storefront-offer-api.
# Node binds 0.0.0.0 by default and MUST keep doing so: Traefik reaches this
# from inside a container via 172.16.1.1, so a 127.0.0.1-only "hardening" would
# be a 502. ufw is what keeps it off the internet — allow 8093 from
# 172.16.1.0/24 only.
PORT=8093
