# Copy to invoices/.env (gitignored) and fill in.
#
# Create the key at https://resend.com/api-keys with "Sending access" only — it never
# needs permission to read or manage domains. Revoke it there if this Mac is ever lost.
#
# THIS REPO IS PUBLIC. invoices/.env is gitignored; never move the key out of it, and
# never paste it into a customer JSON, a commit message or a doc.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
